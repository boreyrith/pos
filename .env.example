# Copy to .env (read by `docker compose --profile app`) or export before `mvn spring-boot:run`.
# Any value left out falls back to the development default in backend/src/main/resources/application.yml.

# Required outside development: openssl rand -base64 48
# JWT_SECRET=
# REFRESH_COOKIE_SECURE=true

# STORE_NAME=POS Store
# STORE_TIMEZONE=Asia/Phnom_Penh

# Encrypts secrets saved in the app (the Bakong API token). openssl rand -base64 32
# SECRETS_KEY=
# KHQR defaults; admins can change all of these under Settings > KHQR payments.
# KHQR: SIMULATED (confirm payments with a button) or BAKONG (confirm through the Bakong API)
# KHQR_MODE=SIMULATED
# BAKONG_ACCOUNT_ID=yourname@bank
# KHQR_MERCHANT_NAME=POS Store
# KHQR_MERCHANT_CITY=Phnom Penh
# BAKONG_TOKEN=

# Held sales: expire after this long without being resumed; release a till's lock after this long.
# HOLD_EXPIRY=24h
# HOLD_LOCK_TIMEOUT=30m
